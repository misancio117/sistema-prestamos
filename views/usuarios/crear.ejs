<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/usuarios" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Nuevo Perfil de Acceso</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary text-[10px] font-bold uppercase tracking-wider border border-accent-primary/20">Alta de Usuario</span>
            </div>
        </header>

        <div class="p-8 max-w-2xl mx-auto">
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="mb-6 p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <div class="card p-8 bg-dark-800/50 border-white/5 space-y-8 shadow-2xl">
                <div class="flex items-center gap-4 border-b border-white/5 pb-6">
                    <div class="w-12 h-12 rounded-2xl bg-accent-primary/10 text-accent-primary flex items-center justify-center text-2xl">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">Credenciales del Sistema</h2>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Configure la identidad y permisos del usuario</p>
                    </div>
                </div>

                <form action="/usuarios/guardar" method="POST" class="space-y-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Nombre Completo del Operador *</label>
                        <input type="text" name="nombre_completo" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" placeholder="Ej: Juan Pérez Sánchez" required>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Correo Institucional *</label>
                            <input type="email" name="email" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" placeholder="usuario@empresa.com" required>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Contraseña de Acceso *</label>
                            <input type="password" name="password" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" placeholder="••••••••" required>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Nivel de Privilegios *</label>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="rol" value="empleado" class="peer absolute opacity-0" checked>
                                <div class="p-4 rounded-xl bg-dark-900 border border-white/5 peer-checked:border-accent-primary peer-checked:bg-accent-primary/5 transition-all">
                                    <h4 class="text-xs font-bold text-white mb-1 uppercase tracking-wider">Empleado</h4>
                                    <p class="text-[10px] text-slate-500">Acceso operativo estándar y consultas.</p>
                                </div>
                            </label>
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="rol" value="admin" class="peer absolute opacity-0">
                                <div class="p-4 rounded-xl bg-dark-900 border border-white/5 peer-checked:border-accent-danger peer-checked:bg-accent-danger/5 transition-all">
                                    <h4 class="text-xs font-bold text-white mb-1 uppercase tracking-wider">Administrador</h4>
                                    <p class="text-[10px] text-slate-500">Control total, gestión de usuarios y ajustes.</p>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="pt-6 flex flex-col md:flex-row gap-4">
                        <button type="submit" class="flex-1 py-4 px-6 rounded-xl bg-accent-primary text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-accent-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <i class="bi bi-shield-check"></i>
                            Activar Usuario
                        </button>
                        <a href="/usuarios" class="flex-1 py-4 px-6 rounded-xl bg-white/5 text-slate-400 font-bold text-xs uppercase tracking-widest border border-white/5 hover:bg-white/10 hover:text-white transition-all text-center">
                            Descartar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>
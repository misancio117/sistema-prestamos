<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<style>
    @media print {
        #sidebar-nav, 
        header, 
        .no-print, 
        #sidebar-toggle, 
        #sidebar-overlay,
        footer,
        .flex.items-center.gap-3 {
            display: none !important;
        }
        main {
            margin-left: 0 !important;
            padding: 0 !important;
            width: 100% !important;
        }
        body {
            background-color: #ffffff !important;
            color: #000000 !important;
            padding: 0 !important;
        }
        .card {
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: none !important;
            color: #000000 !important;
            padding: 10px !important;
            margin: 0 !important;
        }
        h1, h2, h3, p, span, td, th {
            color: #000000 !important;
        }
        table {
            border-collapse: collapse !important;
            width: 100% !important;
        }
        th, td {
            border: 1px solid #cbd5e1 !important;
            padding: 6px 10px !important;
            background: transparent !important;
        }
        tr {
            background: transparent !important;
        }
        .text-white { color: #000000 !important; }
        .text-slate-200 { color: #000000 !important; }
        .text-slate-400 { color: #334155 !important; }
        .text-slate-500 { color: #475569 !important; }
        .bg-white\/5 { background: transparent !important; }
    }
</style>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/prestamos" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Cronograma de Amortización</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary text-[10px] font-bold uppercase tracking-wider border border-accent-primary/20">Consulta</span>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="window.print()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-accent-primary text-white text-sm font-bold shadow-lg shadow-accent-primary/20 hover:scale-105 active:scale-95 transition-all no-print">
                    <i class="bi bi-printer-fill"></i>
                    <span>Imprimir</span>
                </button>
                <a href="/reportes/cronograma_pdf/<%= prestamo.id %>" target="_blank" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-accent-danger text-white text-sm font-bold shadow-lg shadow-accent-danger/20 hover:scale-105 active:scale-95 transition-all no-print">
                    <i class="bi bi-file-earmark-pdf-fill"></i>
                    <span>Exportar PDF</span>
                </a>
            </div>
        </header>

        <div class="p-8 space-y-6">
            <!-- Header Card -->
            <div class="card p-8 bg-dark-800/50 border-white/5 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-8 opacity-10">
                    <i class="bi bi-calendar3 text-8xl text-white"></i>
                </div>
                
                <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                    <div class="space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-2xl bg-accent-info/10 text-accent-info flex items-center justify-center text-2xl font-bold">
                                <%= prestamo.nombre.charAt(0) %>
                            </div>
                            <div>
                                <h2 class="text-xl font-bold text-white"><%= prestamo.nombre %> <%= prestamo.apellido %></h2>
                                <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Expediente Crédito #PR-<%= prestamo.id.toString().padStart(4, '0') %></p>
                            </div>
                        </div>
                        <% if (prestamo.estado === 'finalizado') { %>
                            <div class="mt-3 p-3.5 rounded-xl bg-accent-danger/5 border border-accent-danger/20 space-y-1 max-w-md">
                                <div class="flex items-center gap-2">
                                    <span class="px-2 py-0.5 rounded bg-accent-danger/10 text-accent-danger text-[10px] font-bold uppercase tracking-wider border border-accent-danger/20">
                                        Deuda Finalizada sin Cobro
                                    </span>
                                </div>
                                <p class="text-xs text-slate-300 font-medium">
                                    <span class="text-slate-500 font-bold">Motivo:</span> <%= prestamo.motivo_finalizacion || 'No especificado' %>
                                </p>
                            </div>
                        <% } %>
                        <div class="flex items-center gap-6 pt-2">
                            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 text-[10px] font-bold text-slate-400 uppercase tracking-tighter">
                                <i class="bi bi-repeat text-accent-info"></i>
                                Ciclo: <%= prestamo.frecuencia %>
                            </div>
                            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/5 text-[10px] font-bold text-slate-400 uppercase tracking-tighter">
                                <i class="bi bi-calendar-check text-accent-success"></i>
                                Inicio: <%= prestamo.fecha_inicio ? new Date(prestamo.fecha_inicio + 'T12:00:00').toLocaleDateString() : 'N/D' %>
                            </div>
                        </div>
                    </div>

                    <div class="md:text-right space-y-1">
                        <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em]">Responsabilidad Total</p>
                        <div class="flex items-center md:justify-end gap-3">
                            <span class="text-slate-500 font-bold text-2xl"><%= empresa.moneda %></span>
                            <h3 class="text-4xl font-black text-white tracking-tighter"><%= parseFloat(prestamo.monto_total).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></h3>
                        </div>
                        <p class="text-[10px] text-accent-success font-bold uppercase tracking-tighter">Capital + Intereses Ordinarios</p>
                    </div>
                </div>
            </div>

            <!-- Schedule Table -->
            <div class="card overflow-hidden">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-6">ID Cuota</th>
                                <th>Vencimiento</th>
                                <th>Amortización</th>
                                <th>Interés</th>
                                <th>Monto Cuota</th>
                                <th>Saldo Pendiente</th>
                                <th class="text-end pe-6">Estatus</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cronograma.forEach(cuota => { 
                                const hoy = new Date();
                                const fechaVenc = new Date(cuota.fecha);
                                const vencida = fechaVenc < hoy && cuota.estado !== 'pagado';
                            %>
                                <tr class="group border-b border-white/5 hover:bg-white/[0.01] transition-colors">
                                    <td class="ps-6">
                                        <span class="text-xs font-bold text-slate-500">CU-<%= cuota.numero.toString().padStart(2, '0') %></span>
                                    </td>
                                    <td>
                                        <div class="flex flex-col">
                                            <span class="text-sm font-medium <%= vencida ? 'text-accent-danger' : 'text-slate-300' %>">
                                                <%= cuota.fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                            </span>
                                            <% if(vencida) { %>
                                                <span class="text-[10px] text-accent-danger font-bold uppercase tracking-tighter flex items-center gap-1">
                                                    <i class="bi bi-clock-history"></i> En Mora
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td class="text-sm text-slate-500"><%= empresa.moneda %> <%= (cuota.amortizacion || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-sm text-accent-warning/80"><%= empresa.moneda %> <%= (cuota.interes || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-sm font-bold text-white"><%= empresa.moneda %> <%= cuota.monto.toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-sm font-mono text-slate-500 italic"><%= empresa.moneda %> <%= (cuota.saldo || 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></td>
                                    <td class="text-end pe-6">
                                        <% if(cuota.estado === 'pagado') { %>
                                            <span class="px-2 py-1 rounded-md bg-accent-success/10 text-accent-success text-[10px] font-bold uppercase border border-accent-success/20">
                                                <i class="bi bi-check-lg mr-1"></i>Liquidado
                                            </span>
                                        <% } else if(cuota.estado === 'parcial') { %>
                                            <span class="px-2 py-1 rounded-md bg-accent-warning/10 text-accent-warning text-[10px] font-bold uppercase border border-accent-warning/20">
                                                Abono: <%= empresa.moneda %> <%= cuota.pagado_parcial.toFixed(2) %>
                                            </span>
                                        <% } else { %>
                                            <span class="px-2 py-1 rounded-md bg-white/5 text-slate-400 text-[10px] font-bold uppercase border border-white/10">
                                                Programado
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>

    <script>
        // Si se pasa el parámetro print=true en la URL, llamamos automáticamente al diálogo de impresión
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('print') === 'true') {
                // Pequeña espera para asegurar la carga completa
                setTimeout(() => {
                    window.print();
                }, 300);
            }
        });
    </script>
</body>
</html>
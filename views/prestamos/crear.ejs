<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/prestamos" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Originación de Crédito</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-info/10 text-accent-info text-[10px] font-bold uppercase tracking-wider border border-accent-info/20">Nuevo Registro</span>
            </div>
        </header>

        <div class="p-5">
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="mb-6 p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <form action="/prestamos/guardar" method="POST" id="formPrestamo" enctype="multipart/form-data" class="grid grid-cols-1 xl:grid-cols-12 gap-5">
                
                <!-- Main Form Section -->
                <div class="xl:col-span-8 space-y-5">
                    
                    <!-- Warranty Section -->
                    <div class="card p-5 bg-dark-800/50 space-y-4">
                        <div class="flex items-center gap-3 border-b border-white/5 pb-3">
                            <div class="w-8 h-8 rounded-lg bg-accent-info/10 text-accent-info flex items-center justify-center text-base">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-white uppercase tracking-widest">Garantía / Colateral</h3>
                                <p class="text-[10px] text-slate-500 font-bold uppercase tracking-tighter">Respaldo obligatorio del activo</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Descripción del Artículo</label>
                                <input type="text" name="empeno_nombre_articulo" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" placeholder="Ej: Laptop MacBook Pro 2023" required>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Valor de Tasación (<%= empresa.moneda %>)</label>
                                <input type="number" step="0.01" name="empeno_valor_tasacion" id="inputTasacion" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all font-bold" placeholder="0.00" required>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Documentación Fotográfica</label>
                                <input type="file" name="empeno_imagen" class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-white/5 file:text-slate-300 hover:file:bg-white/10 transition-all" accept="image/*">
                            </div>
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Estado Físico y Observaciones</label>
                                <textarea name="empeno_descripcion" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" rows="1" placeholder="Detalles de conservación..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Details Section -->
                    <div class="card p-5 bg-dark-800/50 space-y-4">
                        <div class="flex items-center gap-3 border-b border-white/5 pb-3">
                            <div class="w-8 h-8 rounded-lg bg-accent-success/10 text-accent-success flex items-center justify-center text-base">
                                <i class="bi bi-currency-exchange"></i>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-white uppercase tracking-widest">Estructura del Crédito</h3>
                                <p class="text-[10px] text-slate-500 font-bold uppercase tracking-tighter">Condiciones y términos financieros</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2 space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Titular del Crédito</label>
                                <div class="relative group" id="autocompleteWrapper">
                                    <i class="bi bi-person-circle absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-info transition-colors text-sm z-10"></i>
                                    <input type="text" id="inputCliente" autocomplete="off" class="w-full pl-9 pr-4 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" placeholder="Escriba nombre, apellido o DNI..." required>
                                    <input type="hidden" name="cliente_id" id="inputClienteId">
                                    <div id="autocompleteList" class="absolute top-full left-0 right-0 mt-1 rounded-lg bg-dark-800 border border-white/10 shadow-2xl z-50 hidden max-h-48 overflow-y-auto custom-scrollbar"></div>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Capital a Desembolsar (<%= empresa.moneda %>)</label>
                                <input type="number" step="0.01" name="monto" id="inputMonto" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all font-bold text-accent-info" required placeholder="0.00">
                                <p id="montoError" class="text-[10px] text-accent-danger font-bold uppercase mt-1 hidden italic">Error: El capital excede la tasación.</p>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Tasa de Interés Mensual (%)</label>
                                <div class="relative">
                                    <input type="number" step="0.01" name="interes" id="inputInteres" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required placeholder="20">
                                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 font-bold text-xs">%</span>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Plazo (N° Cuotas)</label>
                                <input type="number" name="cuotas" id="inputCuotas" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required value="1" min="1">
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Frecuencia de Amortización</label>
                                <select name="frecuencia" id="inputFrecuencia" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required>
                                    <option value="diario">Diario (24h)</option>
                                    <option value="semanal">Semanal (7d)</option>
                                    <option value="quincenal">Quincenal (15d)</option>
                                    <option value="mensual" selected>Mensual (30d)</option>
                                </select>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Fecha del Préstamo (Desembolso)</label>
                                <input type="date" name="fecha_inicio" id="inputFechaInicio" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required value="<%= new Date().toISOString().split('T')[0] %>">
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Fecha de Primer Cobro</label>
                                <input type="date" name="fecha_primer_cobro" id="inputFechaPrimerCobro" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required>
                            </div>

                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Sistema de Amortización</label>
                                <select name="sistema_pago" id="inputSistema" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required>
                                    <option value="frances" selected>Sistema Francés (Cuota Fija)</option>
                                    <option value="aleman">Sistema Alemán (Amortización Fija)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Amortization Table Preview -->
                    <div id="previewPlanContainer" class="card overflow-hidden hidden transition-all duration-500">
                        <div class="p-6 border-b border-white/5 bg-white/[0.02] flex items-center justify-between">
                            <h4 class="text-[10px] font-bold text-white uppercase tracking-[0.2em]">Cronograma Proyectado de Pagos</h4>
                            <span class="text-[10px] text-slate-500 font-bold italic">* Valores informativos sujetos a variación</span>
                        </div>
                        <div class="max-h-[400px] overflow-y-auto custom-scrollbar">
                            <table class="table align-middle mb-0" id="previewTable">
                                <thead class="sticky top-0 bg-dark-800 z-10 shadow-sm">
                                    <tr>
                                        <th class="ps-6">N°</th>
                                        <th>Vencimiento</th>
                                        <th>Amortización</th>
                                        <th>Interés</th>
                                        <th class="text-end pe-6">Total Cuota</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Simulation Sidebar -->
                <div class="xl:col-span-4 space-y-5">
                    <div class="card p-5 bg-dark-900 border-2 border-white/5 sticky top-24">
                        <h4 class="text-xs font-bold text-white uppercase tracking-[0.3em] text-center border-b border-white/5 pb-3 mb-5">Resumen de Operación</h4>
                        
                        <div class="space-y-4">
                            <div class="text-center group">
                                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 group-hover:text-accent-info transition-colors">Capital Solicitado</p>
                                <div class="flex items-center justify-center gap-2">
                                    <span class="text-slate-600 font-bold text-base"><%= empresa.moneda %></span>
                                    <h3 class="text-3xl font-extrabold text-white tracking-tighter" id="simMonto">0.00</h3>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 text-center">
                                    <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Rédito Total</p>
                                    <p class="text-base font-bold text-accent-warning" id="simInteres"><%= empresa.moneda %> 0.00</p>
                                </div>
                                <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 text-center">
                                    <p class="text-[10px] font-bold text-slate-500 uppercase mb-1">Aforo Garantía</p>
                                    <p class="text-base font-bold text-slate-300" id="simTasacion"><%= empresa.moneda %> 0.00</p>
                                </div>
                            </div>

                            <div class="p-4 rounded-xl bg-accent-success/5 border-2 border-accent-success/20 text-center relative overflow-hidden">
                                <div class="absolute inset-0 bg-gradient-to-br from-accent-success/10 to-transparent"></div>
                                <div class="relative z-10">
                                    <p class="text-[10px] font-bold text-accent-success uppercase tracking-widest mb-1">Costo Total del Crédito</p>
                                    <h2 class="text-2xl font-black text-white tracking-tight" id="simTotal"><%= empresa.moneda %> 0.00</h2>
                                </div>
                            </div>

                            <div class="pt-3 space-y-2">
                                <button type="submit" id="btnConfirmar" class="w-full py-2.5 rounded-xl bg-accent-info text-white font-black text-sm uppercase tracking-widest shadow-lg shadow-accent-info/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                    <i class="bi bi-file-earmark-check-fill"></i>
                                    Confirmar Crédito
                                </button>
                                <a href="/prestamos" class="w-full py-2 flex items-center justify-center text-xs font-bold text-slate-500 hover:text-white transition-colors">
                                    Descartar Operación
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </form>
        </div>

        <%- include('../partials/footer') %>
    </main>

    <script>
        const inputMonto = document.getElementById('inputMonto');
        const inputInteres = document.getElementById('inputInteres');
        const inputCuotas = document.getElementById('inputCuotas');
        const inputTasacion = document.getElementById('inputTasacion');
        const inputSistema = document.getElementById('inputSistema');
        const inputFrecuencia = document.getElementById('inputFrecuencia');
        const inputFechaInicio = document.getElementById('inputFechaInicio');
        const inputFechaPrimerCobro = document.getElementById('inputFechaPrimerCobro');
        
        const simMonto = document.getElementById('simMonto');
        const simInteres = document.getElementById('simInteres');
        const simTotal = document.getElementById('simTotal');
        const simTasacion = document.getElementById('simTasacion');
        
        const btnConfirmar = document.getElementById('btnConfirmar');
        const montoError = document.getElementById('montoError');
        
        const previewPlanContainer = document.getElementById('previewPlanContainer');
        const previewTableBody = document.querySelector('#previewTable tbody');
        
        const moneda = "<%= empresa.moneda %>"; 

        function calcular() {
            const m = parseFloat(inputMonto.value) || 0;
            let i = parseFloat(inputInteres.value) || 0;
            const c = parseInt(inputCuotas.value) || 1;
            const tasacion = parseFloat(inputTasacion.value) || 0;
            const sistema = inputSistema.value;
            const frecuencia = inputFrecuencia.value;
            const fechaStr = inputFechaInicio.value;
            const fechaPrimerCobroStr = inputFechaPrimerCobro.value;

            let montoInteres = 0;
            let total = 0;
            let cuotasHtml = '';

            if (m > 0 && c > 0) {
                let fechaObj;
                if (fechaPrimerCobroStr) {
                    fechaObj = new Date(fechaPrimerCobroStr);
                    fechaObj = new Date(fechaObj.getTime() + Math.abs(fechaObj.getTimezoneOffset()*60000));
                } else {
                    fechaObj = new Date(fechaStr || new Date());
                    fechaObj = new Date(fechaObj.getTime() + Math.abs(fechaObj.getTimezoneOffset()*60000));
                }

                if (sistema === 'aleman') {
                    const amortizacion = m / c;
                    let saldo = m;
                    for(let k = 1; k <= c; k++) {
                        const interesCuota = saldo * (i / 100);
                        const cuota = amortizacion + interesCuota;
                        montoInteres += interesCuota;
                        saldo -= amortizacion;
                        
                        if (fechaPrimerCobroStr) {
                            if (k > 1) {
                                if (frecuencia === 'diario') fechaObj.setDate(fechaObj.getDate() + 1);
                                if (frecuencia === 'semanal') fechaObj.setDate(fechaObj.getDate() + 7);
                                if (frecuencia === 'quincenal') fechaObj.setDate(fechaObj.getDate() + 15);
                                if (frecuencia === 'mensual') fechaObj.setMonth(fechaObj.getMonth() + 1);
                            }
                        } else {
                            if (frecuencia === 'diario') fechaObj.setDate(fechaObj.getDate() + 1);
                            if (frecuencia === 'semanal') fechaObj.setDate(fechaObj.getDate() + 7);
                            if (frecuencia === 'quincenal') fechaObj.setDate(fechaObj.getDate() + 15);
                            if (frecuencia === 'mensual') fechaObj.setMonth(fechaObj.getMonth() + 1);
                        }

                        cuotasHtml += `
                            <tr class="group border-b border-white/5 hover:bg-white/[0.01] transition-colors">
                                <td class="ps-6 py-4 font-bold text-slate-500">#${k}</td>
                                <td class="text-sm text-slate-400 font-medium">${fechaObj.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })}</td>
                                <td class="text-sm text-slate-400">${moneda} ${amortizacion.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</td>
                                <td class="text-sm text-accent-warning font-medium">${moneda} ${interesCuota.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</td>
                                <td class="text-end pe-6 text-sm font-bold text-white group-hover:text-accent-info transition-colors">${moneda} ${cuota.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</td>
                            </tr>`;
                    }
                    total = m + montoInteres;
                } else {
                    montoInteres = m * (i / 100) * c;
                    total = m + montoInteres;
                    const cuotaFija = total / c;
                    const amortizacion = m / c;
                    const interesCuota = montoInteres / c;

                    for(let k = 1; k <= c; k++) {
                        if (fechaPrimerCobroStr) {
                            if (k > 1) {
                                if (frecuencia === 'diario') fechaObj.setDate(fechaObj.getDate() + 1);
                                if (frecuencia === 'semanal') fechaObj.setDate(fechaObj.getDate() + 7);
                                if (frecuencia === 'quincenal') fechaObj.setDate(fechaObj.getDate() + 15);
                                if (frecuencia === 'mensual') fechaObj.setMonth(fechaObj.getMonth() + 1);
                            }
                        } else {
                            if (frecuencia === 'diario') fechaObj.setDate(fechaObj.getDate() + 1);
                            if (frecuencia === 'semanal') fechaObj.setDate(fechaObj.getDate() + 7);
                            if (frecuencia === 'quincenal') fechaObj.setDate(fechaObj.getDate() + 15);
                            if (frecuencia === 'mensual') fechaObj.setMonth(fechaObj.getMonth() + 1);
                        }

                        cuotasHtml += `
                            <tr class="group border-b border-white/5 hover:bg-white/[0.01] transition-colors">
                                <td class="ps-6 py-4 font-bold text-slate-500">#${k}</td>
                                <td class="text-sm text-slate-400 font-medium">${fechaObj.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })}</td>
                                <td class="text-sm text-slate-400">${moneda} ${amortizacion.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</td>
                                <td class="text-sm text-accent-warning font-medium">${moneda} ${interesCuota.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</td>
                                <td class="text-end pe-6 text-sm font-bold text-white group-hover:text-accent-info transition-colors">${moneda} ${cuotaFija.toLocaleString('es-ES', { minimumFractionDigits: 2 })}</td>
                            </tr>`;
                    }
                }
                
                previewTableBody.innerHTML = cuotasHtml;
                previewPlanContainer.classList.remove('hidden');
            } else {
                previewPlanContainer.classList.add('hidden');
            }

            simMonto.innerText = m.toLocaleString('es-ES', { minimumFractionDigits: 2 });
            simInteres.innerText = `${moneda} ${montoInteres.toLocaleString('es-ES', { minimumFractionDigits: 2 })}`;
            simTotal.innerText = `${moneda} ${total.toLocaleString('es-ES', { minimumFractionDigits: 2 })}`;
            simTasacion.innerText = `${moneda} ${tasacion.toLocaleString('es-ES', { minimumFractionDigits: 2 })}`;
            
            if (m > tasacion && tasacion > 0) {
                btnConfirmar.disabled = true;
                btnConfirmar.classList.add('opacity-50', 'cursor-not-allowed');
                inputMonto.classList.add('border-accent-danger');
                montoError.classList.remove('hidden');
            } else {
                btnConfirmar.disabled = false;
                btnConfirmar.classList.remove('opacity-50', 'cursor-not-allowed');
                inputMonto.classList.remove('border-accent-danger');
                montoError.classList.add('hidden');
            }
        }

        function actualizarDefaultFechaCobro() {
            const fechaStr = inputFechaInicio.value;
            const frecuencia = inputFrecuencia.value;
            if (fechaStr) {
                let fechaObj = new Date(fechaStr);
                fechaObj = new Date(fechaObj.getTime() + Math.abs(fechaObj.getTimezoneOffset()*60000));
                
                if (frecuencia === 'diario') fechaObj.setDate(fechaObj.getDate() + 1);
                else if (frecuencia === 'semanal') fechaObj.setDate(fechaObj.getDate() + 7);
                else if (frecuencia === 'quincenal') fechaObj.setDate(fechaObj.getDate() + 15);
                else if (frecuencia === 'mensual') fechaObj.setMonth(fechaObj.getMonth() + 1);
                
                inputFechaPrimerCobro.value = fechaObj.toISOString().split('T')[0];
            }
        }

        // Al cargar la página
        actualizarDefaultFechaCobro();
        calcular();

        [inputMonto, inputInteres, inputCuotas, inputTasacion].forEach(el => el.addEventListener('input', calcular));
        [inputSistema, inputFechaPrimerCobro].forEach(el => el.addEventListener('change', calcular));
        
        inputFechaInicio.addEventListener('change', () => {
            actualizarDefaultFechaCobro();
            calcular();
        });
        inputFrecuencia.addEventListener('change', () => {
            actualizarDefaultFechaCobro();
            calcular();
        });

        // Autocomplete Clientes
        const inputCliente = document.getElementById('inputCliente');
        const inputClienteId = document.getElementById('inputClienteId');
        const autocompleteList = document.getElementById('autocompleteList');
        let selectedIndex = -1;
        let currentResults = [];

        function mostrarResultados(resultados) {
            autocompleteList.innerHTML = '';
            currentResults = resultados;
            selectedIndex = -1;

            if (resultados.length === 0) {
                autocompleteList.classList.add('hidden');
                return;
            }

            resultados.forEach((c, i) => {
                const div = document.createElement('div');
                div.className = 'px-3 py-2.5 flex items-center gap-3 cursor-pointer hover:bg-white/5 transition-colors border-b border-white/5 last:border-0';
                div.innerHTML = `
                    <div class="w-7 h-7 rounded-md bg-dark-700 text-slate-400 flex items-center justify-center font-bold text-[10px] shrink-0">${c.nombre.charAt(0)}</div>
                    <div class="min-w-0">
                        <div class="text-sm font-bold text-white truncate">${c.nombre} ${c.apellido}</div>
                        <div class="text-[10px] text-slate-500 font-bold uppercase tracking-tighter">${c.dni}</div>
                    </div>
                `;
                div.addEventListener('click', () => seleccionarCliente(c));
                div.dataset.index = i;
                autocompleteList.appendChild(div);
            });

            autocompleteList.classList.remove('hidden');
        }

        function seleccionarCliente(cliente) {
            inputCliente.value = `${cliente.nombre} ${cliente.apellido} (${cliente.dni})`;
            inputClienteId.value = cliente.id;
            autocompleteList.classList.add('hidden');
            inputCliente.classList.remove('border-accent-warning');
        }

        function resaltarSeleccion() {
            const items = autocompleteList.querySelectorAll('[data-index]');
            items.forEach((item, i) => {
                item.classList.toggle('bg-white/10', i === selectedIndex);
            });
        }

        inputCliente.addEventListener('input', function() {
            const q = this.value.trim();
            inputClienteId.value = '';

            if (q.length < 1) {
                autocompleteList.classList.add('hidden');
                return;
            }

            fetch(`/clientes/buscar?q=${encodeURIComponent(q)}`)
                .then(r => r.json())
                .then(data => mostrarResultados(data))
                .catch(() => autocompleteList.classList.add('hidden'));
        });

        inputCliente.addEventListener('keydown', function(e) {
            const items = autocompleteList.querySelectorAll('[data-index]');
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                resaltarSeleccion();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedIndex = Math.max(selectedIndex - 1, -1);
                resaltarSeleccion();
            } else if (e.key === 'Enter') {
                if (selectedIndex >= 0 && currentResults[selectedIndex]) {
                    e.preventDefault();
                    seleccionarCliente(currentResults[selectedIndex]);
                }
            } else if (e.key === 'Escape') {
                autocompleteList.classList.add('hidden');
            }
        });

        document.addEventListener('click', function(e) {
            if (!document.getElementById('autocompleteWrapper').contains(e.target)) {
                autocompleteList.classList.add('hidden');
            }
        });
    </script>
</body>
</html>
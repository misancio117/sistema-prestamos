<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <h1 class="text-lg font-bold text-white tracking-tight">Corte de Caja Diario</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-info/10 text-accent-info text-[10px] font-bold uppercase tracking-wider border border-accent-info/20">Control de Flujo</span>
            </div>
            
            <form action="/caja" method="GET" class="flex items-center gap-3">
                <div class="relative group">
                    <i class="bi bi-calendar-event absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-accent-primary transition-colors"></i>
                    <input type="date" name="fecha" value="<%= fecha %>" class="bg-white/5 border border-white/10 rounded-xl py-2 pl-10 pr-4 text-xs text-white focus:border-accent-primary focus:ring-0 transition-all cursor-pointer">
                </div>
                <button type="submit" class="px-4 py-2 rounded-xl bg-white/5 text-white text-xs font-bold border border-white/5 hover:bg-white/10 transition-all">
                    Filtrar
                </button>
            </form>
        </header>

        <div class="p-8 max-w-5xl mx-auto space-y-8">
            <!-- Main Balance Dashboard -->
            <div class="card p-10 bg-dark-800/50 border-white/5 relative overflow-hidden group">
                <!-- Abstract background glow -->
                <div class="absolute -top-24 -right-24 w-64 h-64 <%= datos.balanceDia >= 0 ? 'bg-accent-success/10' : 'bg-accent-danger/10' %> blur-[100px] rounded-full transition-colors duration-500"></div>
                
                <div class="relative z-10 flex flex-col items-center text-center space-y-4">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.3em]">Balance Operativo Neto</span>
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold text-slate-500"><%= empresa.moneda %></span>
                        <h1 class="text-7xl font-black tracking-tighter <%= datos.balanceDia >= 0 ? 'text-accent-success' : 'text-accent-danger' %> drop-shadow-2xl">
                            <%= parseFloat(datos.balanceDia).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                        </h1>
                    </div>
                    <div class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/5">
                        <div class="w-1.5 h-1.5 rounded-full <%= datos.balanceDia >= 0 ? 'bg-accent-success animate-pulse' : 'bg-accent-danger' %>"></div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                            Jornada: <%= new Date(fecha).toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </p>
                    </div>
                </div>
            </div>

            <!-- In/Out Detail Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Incomes -->
                <div class="card bg-dark-800/50 border-white/5 overflow-hidden">
                    <div class="px-6 py-4 bg-accent-success/10 border-b border-accent-success/20 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-accent-success/20 text-accent-success flex items-center justify-center">
                                <i class="bi bi-arrow-down-left-circle"></i>
                            </div>
                            <h3 class="text-xs font-bold text-white uppercase tracking-widest">Entradas / Ingresos</h3>
                        </div>
                        <span class="text-xs font-bold text-accent-success">
                            <%= empresa.moneda %> <%= parseFloat(datos.totalIngresos).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                        </span>
                    </div>
                    <div class="p-4 space-y-1">
                        <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/[0.02] transition-colors">
                            <span class="text-xs text-slate-400 font-medium">Recaudación de Préstamos</span>
                            <span class="text-xs font-bold text-slate-200">+ <%= parseFloat(datos.cobrosPrestamos).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                        <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/[0.02] transition-colors">
                            <span class="text-xs text-slate-400 font-medium">Depósitos de Ahorro</span>
                            <span class="text-xs font-bold text-slate-200">+ <%= parseFloat(datos.depositosAhorro).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                    </div>
                </div>

                <!-- Expenses -->
                <div class="card bg-dark-800/50 border-white/5 overflow-hidden">
                    <div class="px-6 py-4 bg-accent-danger/10 border-b border-accent-danger/20 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-accent-danger/20 text-accent-danger flex items-center justify-center">
                                <i class="bi bi-arrow-up-right-circle"></i>
                            </div>
                            <h3 class="text-xs font-bold text-white uppercase tracking-widest">Salidas / Egresos</h3>
                        </div>
                        <span class="text-xs font-bold text-accent-danger">
                            <%= empresa.moneda %> <%= parseFloat(datos.totalEgresos).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                        </span>
                    </div>
                    <div class="p-4 space-y-1">
                        <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/[0.02] transition-colors">
                            <span class="text-xs text-slate-400 font-medium">Desembolsos de Préstamos</span>
                            <span class="text-xs font-bold text-slate-200">- <%= parseFloat(datos.salidasPrestamos).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                        <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/[0.02] transition-colors">
                            <span class="text-xs text-slate-400 font-medium">Retiros de Cuentas Ahorro</span>
                            <span class="text-xs font-bold text-slate-200">- <%= parseFloat(datos.retirosAhorro).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                        <div class="flex items-center justify-between p-3 rounded-xl hover:bg-white/[0.02] transition-colors">
                            <span class="text-xs text-slate-400 font-medium">Gastos Administrativos</span>
                            <span class="text-xs font-bold text-slate-200">- <%= parseFloat(datos.gastosOperativos).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col items-center gap-6 pt-4">
                <a href="/caja/imprimir?fecha=<%= fecha %>" target="_blank" class="w-full md:w-auto px-12 py-4 rounded-2xl bg-white text-dark-900 font-bold text-xs uppercase tracking-[0.2em] shadow-xl shadow-white/5 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-3 group">
                    <i class="bi bi-printer-fill text-lg group-hover:rotate-12 transition-transform"></i>
                    Generar Comprobante de Cierre
                </a>
                <div class="flex items-center gap-3 px-6 py-3 rounded-xl bg-white/5 border border-white/5">
                    <i class="bi bi-info-circle-fill text-accent-info"></i>
                    <p class="text-[10px] text-slate-500 font-bold uppercase tracking-wider">
                        El reporte se exportará en formato térmico optimizado para 80mm
                    </p>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>
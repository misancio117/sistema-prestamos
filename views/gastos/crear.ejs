<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/gastos" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Registro de Egreso</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-danger/10 text-accent-danger text-[10px] font-bold uppercase tracking-wider border border-accent-danger/20">Operación Manual</span>
            </div>
        </header>

        <div class="p-8 max-w-2xl mx-auto">
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="mb-6 p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <div class="card p-8 bg-dark-800/50 border-white/5 space-y-8 shadow-2xl">
                <div class="flex items-center gap-4 border-b border-white/5 pb-6">
                    <div class="w-12 h-12 rounded-2xl bg-accent-danger/10 text-accent-danger flex items-center justify-center text-2xl">
                        <i class="bi bi-dash-circle"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">Detalle del Egreso</h2>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Especifique el origen y destino de los fondos</p>
                    </div>
                </div>

                <form action="/gastos/guardar" method="POST" class="space-y-6">
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Fecha Contable *</label>
                        <input type="date" name="fecha_gasto" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-danger focus:ring-0 transition-all cursor-pointer" value="<%= fechaHoy %>" required>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Descripción del Concepto *</label>
                        <input type="text" name="descripcion" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-danger focus:ring-0 transition-all" placeholder="Ej: Adquisición de materiales de escritorio..." required>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Categoría Operativa *</label>
                            <select name="categoria" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-danger focus:ring-0 transition-all cursor-pointer" required>
                                <option value="Servicios Básicos">Servicios (Luz/Agua)</option>
                                <option value="Alquiler">Alquiler / Arrendamiento</option>
                                <option value="Personal">Nómina / Personal</option>
                                <option value="Suministros">Suministros de Oficina</option>
                                <option value="Mantenimiento">Mantenimiento Infraestructura</option>
                                <option value="Otros">Gastos Diversos</option>
                            </select>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Monto a Retirar *</label>
                            <div class="relative">
                                <input type="number" step="0.01" name="monto" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white font-bold focus:border-accent-danger focus:ring-0 transition-all" placeholder="0.00" required>
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xs"><%= empresa.moneda %></span>
                            </div>
                        </div>
                    </div>

                    <div class="pt-6 flex flex-col md:flex-row gap-4">
                        <button type="submit" class="flex-1 py-4 px-6 rounded-xl bg-accent-danger text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-accent-danger/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <i class="bi bi-save-fill"></i>
                            Registrar Transacción
                        </button>
                        <a href="/gastos" class="flex-1 py-4 px-6 rounded-xl bg-white/5 text-slate-400 font-bold text-xs uppercase tracking-widest border border-white/5 hover:bg-white/10 hover:text-white transition-all text-center">
                            Descartar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/clientes" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Nuevo Cliente</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-success/10 text-accent-success text-[10px] font-bold uppercase tracking-wider border border-accent-success/20">Registro</span>
            </div>
        </header>

        <div class="p-5 flex justify-center">
            <div class="w-full max-w-xl space-y-5">
                <div class="card p-5 bg-dark-800/50">
                    <form action="/clientes/guardar" method="POST" enctype="multipart/form-data" class="space-y-4">
                        
                        <!-- Profile Photo Section -->
                        <div class="flex flex-col sm:flex-row items-center gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/5">
                            <div class="relative group">
                                <div class="w-20 h-20 rounded-2xl bg-dark-900 border-2 border-dashed border-white/10 flex items-center justify-center text-slate-500 group-hover:border-accent-info group-hover:text-accent-info transition-all cursor-pointer overflow-hidden shadow-inner">
                                    <i class="bi bi-camera text-2xl"></i>
                                    <input type="file" name="foto" class="absolute inset-0 opacity-0 cursor-pointer" accept="image/*" onchange="previewImage(this)">
                                    <img id="image-preview" class="absolute inset-0 w-full h-full object-cover hidden">
                                </div>
                            </div>
                            <div class="flex-1 text-center sm:text-left">
                                <h3 class="text-xs font-bold text-white uppercase tracking-wider">Foto de Perfil</h3>
                                <p class="text-xs text-slate-500 mt-1">Sube una imagen clara del cliente. Formatos: JPG o PNG.</p>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] border-b border-white/5 pb-2">Información Personal</h4>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">DNI / Identificación <span class="text-accent-danger">*</span></label>
                                    <div class="relative group">
                                        <i class="bi bi-card-text absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-info transition-colors text-sm"></i>
                                        <input type="text" name="dni" class="w-full pl-9 pr-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required placeholder="000000000">
                                    </div>
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Teléfono Móvil</label>
                                    <div class="relative group">
                                        <i class="bi bi-telephone absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-info transition-colors text-sm"></i>
                                        <input type="text" name="telefono" class="w-full pl-9 pr-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" placeholder="+00 000 000 000">
                                    </div>
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Nombre(s) <span class="text-accent-danger">*</span></label>
                                    <input type="text" name="nombre" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required placeholder="Ej: Juan">
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Apellido(s) <span class="text-accent-danger">*</span></label>
                                    <input type="text" name="apellido" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" required placeholder="Ej: Pérez">
                                </div>

                                <div class="md:col-span-2 space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Dirección de Domicilio</label>
                                    <div class="relative group">
                                        <i class="bi bi-geo-alt absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-info transition-colors text-sm"></i>
                                        <input type="text" name="direccion" class="w-full pl-9 pr-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-info focus:ring-0 transition-all" placeholder="Calle, Número, Ciudad...">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-white/5 flex items-center justify-end gap-3">
                            <a href="/clientes" class="px-4 py-2 rounded-lg text-xs font-bold text-slate-500 hover:bg-white/5 transition-colors">
                                Cancelar
                            </a>
                            <button type="submit" class="px-6 py-2 rounded-lg bg-accent-info text-white text-xs font-bold shadow-lg shadow-accent-info/20 hover:scale-105 active:scale-95 transition-all flex items-center gap-2">
                                <i class="bi bi-save2-fill"></i>
                                Registrar Cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>

    <script>
        function previewImage(input) {
            const preview = document.getElementById('image-preview');
            const icon = preview.previousElementSibling;
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    icon.classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>
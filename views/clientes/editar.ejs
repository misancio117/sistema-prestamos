<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-4 sm:px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/clientes" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Editar Cliente</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-warning/10 text-accent-warning text-[10px] font-bold uppercase tracking-wider border border-accent-warning/20">Modificación</span>
            </div>
        </header>

        <div class="p-4 sm:p-5 flex justify-center">
            <div class="w-full max-w-xl space-y-5">

                <% if(mensajeError && mensajeError.length > 0) { %>
                    <div class="p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <%= mensajeError %>
                    </div>
                <% } %>

                <div class="card p-5 bg-dark-800/50">
                    <form action="/clientes/actualizar/<%= cliente.id %>" method="POST" enctype="multipart/form-data" class="space-y-4">

                        <!-- Profile Photo Section -->
                        <div class="flex flex-col sm:flex-row items-center gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/5">
                            <div class="relative group">
                                <div id="photo-container" class="w-20 h-20 rounded-2xl bg-dark-900 border-2 border-dashed border-white/10 flex items-center justify-center text-slate-500 group-hover:border-accent-warning group-hover:text-accent-warning transition-all cursor-pointer overflow-hidden shadow-inner">
                                    <% if (cliente.foto) { %>
                                        <img id="image-preview" src="/uploads/<%= cliente.foto %>" alt="Foto" class="w-full h-full object-cover">
                                        <input type="file" name="foto" class="absolute inset-0 opacity-0 cursor-pointer" accept="image/*" onchange="previewImage(this)">
                                    <% } else { %>
                                        <i class="bi bi-camera text-2xl" id="photo-icon"></i>
                                        <input type="file" name="foto" class="absolute inset-0 opacity-0 cursor-pointer" accept="image/*" onchange="previewImage(this)">
                                        <img id="image-preview" class="absolute inset-0 w-full h-full object-cover hidden">
                                    <% } %>
                                </div>
                            </div>
                            <div class="flex-1 text-center sm:text-left">
                                <h3 class="text-xs font-bold text-white uppercase tracking-wider">Foto de Perfil</h3>
                                <p class="text-xs text-slate-500 mt-1">Sube una nueva imagen para reemplazar la actual. Formatos: JPG o PNG.</p>
                                <% if (cliente.foto) { %>
                                    <p class="text-[10px] text-accent-warning font-bold mt-2 uppercase tracking-wider"><i class="bi bi-check-circle me-1"></i>Foto registrada</p>
                                <% } %>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <h4 class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] border-b border-white/5 pb-2">Información Personal</h4>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">DNI / Identificación <span class="text-accent-danger">*</span></label>
                                    <div class="relative group">
                                        <i class="bi bi-card-text absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-warning transition-colors text-sm"></i>
                                        <input type="text" name="dni" class="w-full pl-9 pr-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-warning focus:ring-0 transition-all" required value="<%= cliente.dni %>">
                                    </div>
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Teléfono Móvil</label>
                                    <div class="relative group">
                                        <i class="bi bi-telephone absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-warning transition-colors text-sm"></i>
                                        <input type="text" name="telefono" class="w-full pl-9 pr-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-warning focus:ring-0 transition-all" value="<%= cliente.telefono || '' %>">
                                    </div>
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Nombre(s) <span class="text-accent-danger">*</span></label>
                                    <input type="text" name="nombre" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-warning focus:ring-0 transition-all" required value="<%= cliente.nombre %>">
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Apellido(s) <span class="text-accent-danger">*</span></label>
                                    <input type="text" name="apellido" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-warning focus:ring-0 transition-all" required value="<%= cliente.apellido %>">
                                </div>

                                <div class="md:col-span-2 space-y-1">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Dirección de Domicilio</label>
                                    <div class="relative group">
                                        <i class="bi bi-geo-alt absolute left-3 top-1/2 -translate-y-1/2 text-slate-600 group-focus-within:text-accent-warning transition-colors text-sm"></i>
                                        <input type="text" name="direccion" class="w-full pl-9 pr-3 py-2 bg-dark-900 border border-white/10 rounded-lg text-sm text-white focus:border-accent-warning focus:ring-0 transition-all" value="<%= cliente.direccion || '' %>">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-white/5 flex flex-col sm:flex-row items-center justify-end gap-3">
                            <a href="/clientes" class="w-full sm:w-auto text-center px-4 py-2 rounded-lg text-xs font-bold text-slate-500 hover:bg-white/5 transition-colors">
                                Cancelar
                            </a>
                            <button type="submit" class="w-full sm:w-auto px-6 py-2 rounded-lg bg-accent-warning text-dark-900 text-xs font-bold shadow-lg shadow-accent-warning/20 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-2">
                                <i class="bi bi-pencil-square"></i>
                                Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>

    <script>
        function previewImage(input) {
            const preview = document.getElementById('image-preview');
            const icon = document.getElementById('photo-icon');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    if (icon) icon.classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <header class="h-12 border-b border-white/5 flex items-center justify-between px-6 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-3">
                <a href="/prestamos" class="p-1.5 rounded-lg bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="text-sm font-bold text-white tracking-tight">Procesar Recaudo</h1>
                <span class="px-1.5 py-0.5 rounded-md bg-accent-success/10 text-accent-success text-[9px] font-bold uppercase tracking-wider border border-accent-success/20">Operación de Caja</span>
            </div>
        </header>

        <div class="p-4">
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="mb-3 p-2.5 rounded-lg bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-xs font-bold flex items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <div class="grid grid-cols-1 xl:grid-cols-12 gap-4">
                
                <!-- Summary Column -->
                <div class="xl:col-span-5 space-y-3">
                    <div class="card p-4 bg-dark-800/50 space-y-3 border-white/5">
                        <div class="flex items-center gap-2 border-b border-white/5 pb-2">
                            <div class="w-6 h-6 rounded-lg bg-accent-info/10 text-accent-info flex items-center justify-center text-xs">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <h3 class="text-[11px] font-bold text-white uppercase tracking-widest">Titular del Crédito</h3>
                                <p class="text-[8px] text-slate-500 font-bold uppercase tracking-tighter">Expediente #PR-<%= prestamo.id.toString().padStart(4, '0') %></p>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <div>
                                <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mb-0.5">Nombre Completo</p>
                                <p class="text-sm font-bold text-white"><%= prestamo.nombre %> <%= prestamo.apellido %></p>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mb-0.5">Capital Original</p>
                                    <p class="text-[11px] font-bold text-slate-300"><%= empresa.moneda %> <%= parseFloat(prestamo.monto_prestado).toLocaleString() %></p>
                                </div>
                                <div>
                                    <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mb-0.5">Interés Tasa</p>
                                    <p class="text-[11px] font-bold text-slate-300"><%= parseFloat(prestamo.tasa_interes).toFixed(2) %>% (<%= prestamo.frecuencia %>)</p>
                                </div>
                            </div>
                            <div>
                                <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest mb-0.5">Fecha del Préstamo</p>
                                <p class="text-[11px] font-bold text-slate-300"><%= new Date(prestamo.fecha_inicio).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                            </div>
                        </div>

                        <% if (typeof empeno !== 'undefined' && empeno) { %>
                            <div class="p-2.5 rounded-xl bg-accent-warning/5 border border-accent-warning/20 space-y-1">
                                <div class="flex items-center gap-1.5 text-accent-warning">
                                    <i class="bi bi-shield-lock-fill text-[10px]"></i>
                                    <span class="text-[8px] font-bold uppercase tracking-widest">Garantía Activa</span>
                                </div>
                                <p class="text-xs font-bold text-white"><%= empeno.nombre_articulo %></p>
                                <p class="text-[8px] text-slate-500 font-bold uppercase">Valuación: <%= empresa.moneda %> <%= parseFloat(empeno.valor_tasacion).toLocaleString() %></p>
                            </div>
                        <% } else { %>
                            <div class="p-2.5 rounded-xl bg-white/5 border border-white/5 flex items-center gap-2 text-slate-500 italic text-[10px]">
                                <i class="bi bi-info-circle"></i>
                                Sin garantías prendarias vinculadas.
                            </div>
                        <% } %>

                        <div class="p-3 rounded-xl bg-dark-900 border border-accent-danger/20 text-center relative overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-br from-accent-danger/5 to-transparent"></div>
                            <div class="relative z-10">
                                <p class="text-[8px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-0.5">Exigibilidad Pendiente</p>
                                <div class="flex items-center justify-center gap-1.5 text-accent-danger">
                                    <span class="text-sm font-bold"><%= empresa.moneda %></span>
                                    <h2 class="text-lg font-bold tracking-tighter"><%= parseFloat(saldoPendiente).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %></h2>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <p class="text-[8px] font-bold text-slate-500 uppercase tracking-widest flex items-center gap-1.5">
                                <i class="bi bi-clock-history text-accent-info"></i>
                                Historial de Abonos
                            </p>
                            <% if(historial.length > 0) { %>
                                <% historial.forEach(h => { %>
                                    <div class="flex justify-between items-center p-2 rounded-xl bg-white/[0.02] border border-white/5">
                                        <div class="flex flex-col">
                                            <span class="text-[8px] font-bold text-slate-500"><%= new Date(h.fecha_pago).toLocaleDateString() %></span>
                                            <span class="text-[7px] text-slate-600 uppercase font-bold tracking-tighter"><%= new Date(h.fecha_pago).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                                        </div>
                                        <span class="text-[10px] font-bold text-accent-success">+<%= empresa.moneda %> <%= parseFloat(h.monto_pagado).toLocaleString() %></span>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <p class="text-center py-2 text-[8px] font-bold text-slate-600 uppercase italic tracking-widest">Sin transacciones previas</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Form Column -->
                <div class="xl:col-span-7">
                    <div class="card p-4 bg-dark-800/50 space-y-4 border-white/5 h-full">
                        <div class="flex items-center gap-2 border-b border-white/5 pb-2">
                            <div class="w-6 h-6 rounded-lg bg-accent-success/10 text-accent-success flex items-center justify-center text-xs">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div>
                                <h3 class="text-[11px] font-bold text-white uppercase tracking-widest">Ingreso de Valores</h3>
                                <p class="text-[8px] text-slate-500 font-bold uppercase tracking-tighter">Registre la entrada de efectivo a caja</p>
                            </div>
                        </div>

                        <form action="/pagos/guardar" method="POST" class="space-y-4">
                            <input type="hidden" name="prestamo_id" value="<%= prestamo.id %>">
                            <input type="hidden" name="es_liquidacion" id="es_liquidacion" value="no">

                            <div class="space-y-3">
                                <div class="space-y-2">
                                    <label class="text-[8px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Monto de la Transacción (<%= empresa.moneda %>)</label>
                                    <div class="relative group">
                                        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-600 group-focus-within:text-accent-success transition-colors"><%= empresa.moneda %></div>
                                        <input type="number" step="0.01" name="monto_pagado" id="inputMontoPagado" class="w-full pl-8 pr-3 py-2.5 bg-dark-900 border border-white/10 rounded-xl text-base font-bold text-white focus:border-accent-success focus:ring-0 transition-all placeholder:text-slate-800" placeholder="0.00" required autofocus>
                                    </div>
                                    
                                    <div class="grid grid-cols-2 gap-2">
                                        <button type="button" class="py-1.5 rounded-xl bg-white/5 text-white text-[9px] font-bold uppercase tracking-widest border border-white/5 hover:bg-accent-info/10 hover:border-accent-info/20 hover:text-accent-info transition-all flex items-center justify-center gap-1.5" onclick="document.getElementById('inputMontoPagado').value='<%= (prestamo.monto_total / prestamo.cuotas).toFixed(2) %>'; document.getElementById('es_liquidacion').value='no';">
                                            <i class="bi bi-1-circle"></i>
                                            Pagar 1 Cuota
                                        </button>
                                        <button type="button" class="py-1.5 rounded-xl bg-accent-danger/5 text-accent-danger text-[9px] font-bold uppercase tracking-widest border border-accent-danger/20 hover:bg-accent-danger hover:text-white transition-all flex items-center justify-center gap-1.5" onclick="document.getElementById('inputMontoPagado').value='<%= liquidacionTotal.toFixed(2) %>'; document.getElementById('es_liquidacion').value='si';">
                                            <i class="bi bi-lightning-charge"></i>
                                            Liquidación Total
                                        </button>
                                    </div>
                                </div>

                                <div class="p-3 rounded-xl bg-white/[0.02] border border-white/5 space-y-1.5">
                                    <div class="flex justify-between items-center text-[9px] font-bold uppercase tracking-widest">
                                        <span class="text-slate-500">Deuda Restante Estimada</span>
                                        <span class="text-slate-300"><%= empresa.moneda %> <%= parseFloat(saldoPendiente).toLocaleString() %></span>
                                    </div>
                                    <div class="flex justify-between items-center text-[9px] font-bold uppercase tracking-widest pt-1.5 border-t border-white/5">
                                        <span class="text-accent-danger">Liquidación Inmediata</span>
                                        <span class="text-accent-danger font-black"><%= empresa.moneda %> <%= liquidacionTotal.toLocaleString() %></span>
                                    </div>
                                </div>

                                <div class="space-y-1">
                                    <label class="text-[8px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Observaciones</label>
                                    <textarea name="observaciones" class="w-full px-3 py-2 bg-dark-900 border border-white/10 rounded-xl text-[10px] text-white focus:border-accent-success focus:ring-0 transition-all" rows="1" placeholder="Concepto del pago..."></textarea>
                                </div>
                            </div>

                            <div class="pt-3 space-y-2">
                                <button type="submit" class="w-full py-2 rounded-xl bg-accent-success text-white font-bold text-[10px] uppercase tracking-widest shadow-lg shadow-accent-success/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                    <i class="bi bi-check-all"></i>
                                    Confirmar y Procesar Pago
                                </button>
                                <a href="/prestamos" class="w-full py-1 flex items-center justify-center text-[8px] font-bold text-slate-500 hover:text-white transition-colors uppercase tracking-widest">
                                    Cancelar Operación
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/ahorros" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Apertura de Cuenta</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary text-[10px] font-bold uppercase tracking-wider border border-accent-primary/20">Registro Inicial</span>
            </div>
        </header>

        <div class="p-8 max-w-4xl mx-auto">
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="mb-6 p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <div class="card p-8 bg-dark-800/50 border-white/5 space-y-8">
                <div class="flex items-center gap-4 border-b border-white/5 pb-6">
                    <div class="w-12 h-12 rounded-2xl bg-accent-info/10 text-accent-info flex items-center justify-center text-2xl">
                        <i class="bi bi-piggy-bank"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">Configuración del Producto</h2>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Defina los términos del instrumento de ahorro</p>
                    </div>
                </div>

                <form action="/ahorros/guardar" method="POST" class="space-y-6">
                    <!-- Client Selection -->
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Titular de la Cuenta *</label>
                        <select name="cliente_id" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all cursor-pointer" required>
                            <option value="" disabled selected>-- Vincular un cliente existente --</option>
                            <% clientes.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.nombre %> <%= c.apellido %> (DNI: <%= c.dni %>)</option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Financial Terms -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Rendimiento Anual (%) *</label>
                            <div class="relative">
                                <input type="number" step="0.01" min="0" max="100" name="tasa_interes" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all font-bold" placeholder="0.00" required>
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xs">%</span>
                            </div>
                            <p class="text-[10px] text-slate-500 italic mt-1">Interés capitalizable que se acreditará a la cuenta.</p>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Horizonte de Plazo (Meses) *</label>
                            <div class="relative">
                                <input type="number" min="1" max="120" name="plazo_meses" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all font-bold" placeholder="12" required>
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xs">M</span>
                            </div>
                            <p class="text-[10px] text-slate-500 italic mt-1">Periodo de permanencia sugerido para el cliente.</p>
                        </div>
                    </div>

                    <!-- Info Alert -->
                    <div class="p-4 rounded-xl bg-accent-info/5 border border-accent-info/20 flex gap-3">
                        <i class="bi bi-info-circle-fill text-accent-info mt-0.5"></i>
                        <p class="text-xs text-slate-400 leading-relaxed">
                            <strong class="text-slate-200">Nota de Apertura:</strong> La cuenta se inicializará con balance cero. Los depósitos iniciales y subsecuentes se gestionarán a través del panel de transacciones una vez creada la cuenta.
                        </p>
                    </div>

                    <div class="pt-6 flex flex-col md:flex-row gap-4">
                        <button type="submit" class="flex-1 py-3 px-6 rounded-xl bg-accent-primary text-white font-bold text-sm uppercase tracking-widest shadow-lg shadow-accent-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                            <i class="bi bi-check-lg"></i>
                            Confirmar Apertura
                        </button>
                        <a href="/ahorros" class="flex-1 py-3 px-6 rounded-xl bg-white/5 text-slate-400 font-bold text-sm uppercase tracking-widest border border-white/5 hover:bg-white/10 hover:text-white transition-all text-center">
                            Descartar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>
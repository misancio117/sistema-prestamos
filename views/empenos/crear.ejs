<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <a href="/empenos" class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors">
                    <i class="bi bi-arrow-left text-lg"></i>
                </a>
                <h1 class="text-lg font-bold text-white tracking-tight">Registro de Garantía Real</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary text-[10px] font-bold uppercase tracking-wider border border-accent-primary/20">Alta de Activo</span>
            </div>
        </header>

        <div class="p-8 max-w-4xl mx-auto">
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="mb-6 p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <div class="card p-8 bg-dark-800/50 border-white/5 space-y-8 shadow-2xl">
                <div class="flex items-center gap-4 border-b border-white/5 pb-6">
                    <div class="w-12 h-12 rounded-2xl bg-accent-primary/10 text-accent-primary flex items-center justify-center text-2xl">
                        <i class="bi bi-safe"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-white">Detalles del Empeño</h2>
                        <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Vincule el activo a un cliente y defina los valores</p>
                    </div>
                </div>

                <form action="/empenos/guardar" method="POST" enctype="multipart/form-data" class="space-y-6">
                    <!-- Client Selection -->
                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Cliente Propietario *</label>
                        <select name="cliente_id" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all cursor-pointer" required>
                            <option value="">-- Seleccionar Titular --</option>
                            <% clientes.forEach(c => { %>
                                <option value="<%= c.id %>"><%= c.nombre %> <%= c.apellido %> (DNI: <%= c.dni %>)</option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Item Info -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Denominación del Artículo *</label>
                            <input type="text" name="nombre_articulo" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" placeholder="Ej: Laptop HP Pavilion 15''" required>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Fecha Límite *</label>
                            <input type="date" name="fecha_limite" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all cursor-pointer" value="<%= new Date(new Date().setMonth(new Date().getMonth() + 1)).toISOString().split('T')[0] %>" required>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Estado de Conservación / Observaciones</label>
                        <textarea name="descripcion" rows="3" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all resize-none" placeholder="Detalle el estado físico, accesorios incluidos, número de serie..."></textarea>
                    </div>

                    <!-- Valuation Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Valor de Tasación (Mercado)</label>
                            <div class="relative">
                                <input type="number" step="0.01" name="valor_tasacion" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white font-bold focus:border-accent-primary transition-all" placeholder="0.00">
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xs"><%= empresa.moneda %></span>
                            </div>
                            <p class="text-[9px] text-slate-600 font-bold uppercase ml-1">Referencia para el seguro</p>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Monto Financiado *</label>
                            <div class="relative">
                                <input type="number" step="0.01" name="monto_prestado" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-accent-primary/30 rounded-xl text-sm text-white font-bold focus:border-accent-primary transition-all shadow-lg shadow-accent-primary/5" placeholder="0.00" required>
                                <span class="absolute right-4 top-1/2 -translate-y-1/2 text-accent-primary font-bold text-xs"><%= empresa.moneda %></span>
                            </div>
                            <p class="text-[9px] text-accent-primary/70 font-bold uppercase ml-1">Dinero efectivo entregado</p>
                        </div>
                    </div>

                    <!-- File Upload -->
                    <div class="space-y-4 pt-4">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Evidencia Fotográfica</label>
                        <div class="flex items-center justify-center w-full">
                            <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-white/10 rounded-2xl cursor-pointer bg-dark-900 hover:bg-white/[0.02] hover:border-accent-primary/30 transition-all group">
                                <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                    <i class="bi bi-camera text-2xl text-slate-600 mb-2 group-hover:text-accent-primary transition-colors"></i>
                                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Haga clic para subir la foto del artículo</p>
                                </div>
                                <input type="file" name="imagen" class="hidden" accept="image/*" />
                            </label>
                        </div>
                    </div>

                    <div class="pt-8 flex flex-col md:flex-row gap-4">
                        <button type="submit" class="flex-1 py-4 px-6 rounded-xl bg-accent-primary text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-accent-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 group">
                            <i class="bi bi-safe-fill group-hover:rotate-12 transition-transform"></i>
                            Registrar Garantía en Bóveda
                        </button>
                        <a href="/empenos" class="flex-1 py-4 px-6 rounded-xl bg-white/5 text-slate-400 font-bold text-xs uppercase tracking-widest border border-white/5 hover:bg-white/10 hover:text-white transition-all text-center">
                            Descartar
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>
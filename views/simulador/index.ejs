<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<head>
    <style>
        /* CSS overrides for high-quality printing */
        @media print {
            @page {
                size: letter;
                margin: 0.3in !important;
            }
            body {
                background-color: #ffffff !important;
                color: #1a1a1a !important;
                font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
                font-size: 10px !important;
                line-height: 1.2 !important;
            }
            
            /* Hide all interactive screen elements */
            .screen-only-layout, sidebar, .sidebar, header, footer, .lg\:col-span-4, button, a, .bi-info-circle-fill {
                display: none !important;
            }
            
            /* Make printing layout visible and reset sizing */
            .print-only-layout {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                box-sizing: border-box !important;
            }
            
            main {
                margin: 0 !important;
                padding: 0 !important;
                background: transparent !important;
            }
            
            .card {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                max-height: none !important;
                overflow: visible !important;
            }

            .print-header {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                border-bottom: 2px solid #e2e8f0;
                padding-bottom: 0.5rem;
                margin-bottom: 0.5rem;
            }
            
            .print-logo-container {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }
            
            .print-logo {
                height: 2.2rem;
                object-fit: contain;
            }
            
            .print-logo-placeholder {
                width: 2.2rem;
                height: 2.2rem;
                background-color: #0f172a;
                color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                border-radius: 0.5rem;
                font-size: 1.1rem;
            }

            .company-details {
                text-align: right;
                font-size: 0.65rem;
                color: #475569;
                line-height: 1.3;
            }

            .print-title {
                text-align: center;
                margin-bottom: 0.5rem;
            }
            
            .print-title h1 {
                font-size: 1.1rem;
                font-weight: 800;
                color: #0f172a;
                letter-spacing: -0.025em;
                text-transform: uppercase;
                margin: 0;
            }
            
            .print-title p {
                font-size: 0.65rem;
                color: #64748b;
                margin-top: 0.1rem;
                font-weight: 700;
            }

            .print-meta-grid {
                display: grid;
                grid-template-cols: repeat(3, 1fr);
                gap: 0.5rem;
                background-color: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 0.5rem;
                padding: 0.5rem;
                margin-bottom: 0.5rem;
                font-size: 0.7rem;
            }
            
            .print-meta-item span {
                font-weight: 700;
                color: #475569;
                display: block;
                font-size: 0.55rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            
            .print-meta-item p {
                font-size: 0.75rem;
                font-weight: 800;
                color: #0f172a;
                margin: 0;
            }

            .print-summary-row {
                display: grid;
                grid-template-cols: repeat(3, 1fr);
                gap: 0.5rem;
                margin-bottom: 0.5rem;
            }
            
            .print-summary-card {
                border: 1px solid #e2e8f0;
                border-radius: 0.5rem;
                padding: 0.4rem;
                text-align: center;
                background-color: #f8fafc;
            }
            
            .print-summary-card.highlight {
                background-color: #f0fdf4;
                border-color: #bbf7d0;
            }
            
            .print-summary-card span {
                font-size: 0.55rem;
                font-weight: 700;
                color: #64748b;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                display: block;
            }
            
            .print-summary-card p {
                font-size: 0.95rem;
                font-weight: 900;
                color: #0f172a;
                margin: 0;
            }

            .print-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 0.5rem;
                font-size: 0.65rem;
            }
            
            .print-table th {
                background-color: #f1f5f9;
                border-bottom: 1.5px solid #cbd5e1;
                font-weight: 800;
                text-transform: uppercase;
                color: #475569;
                padding: 0.25rem 0.4rem;
                text-align: right;
            }
            
            .print-table th:first-child, .print-table th:nth-child(2) {
                text-align: left;
            }
            
            .print-table td {
                border-bottom: 1px solid #e2e8f0;
                padding: 0.2rem 0.4rem;
                text-align: right;
                color: #334155;
            }
            
            .print-table td:first-child, .print-table td:nth-child(2) {
                text-align: left;
            }
            
            .print-table tr:nth-child(even) {
                background-color: #f8fafc;
            }

            .print-footer {
                border-top: 1px dashed #cbd5e1;
                padding-top: 0.4rem;
                margin-top: 0.5rem;
                font-size: 0.55rem;
                color: #64748b;
                line-height: 1.3;
                text-align: justify;
            }

            .print-signatures {
                display: grid;
                grid-template-cols: repeat(2, 1fr);
                gap: 2rem;
                margin-top: 1.5rem;
                text-align: center;
                font-size: 0.65rem;
                color: #475569;
            }
            
            .signature-line {
                border-top: 1px solid #cbd5e1;
                padding-top: 0.25rem;
                width: 70%;
                margin: 0 auto;
                font-weight: 700;
            }
        }

        /* Screen only rules */
        .print-only-layout {
            display: none;
        }
    </style>
</head>
<body class="bg-dark-900 text-slate-200">
    <div class="screen-only-layout">
        <%- include('../partials/sidebar') %>

        <main class="transition-all duration-300">
            <!-- Top Navbar -->
            <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
                <div class="flex items-center gap-4">
                    <h1 class="text-lg font-bold text-white tracking-tight">Proyectista Financiero</h1>
                    <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary text-[10px] font-bold uppercase tracking-wider border border-accent-primary/20">Simulador de Crédito</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1 rounded-lg bg-white/5 text-[10px] font-bold text-slate-500 uppercase tracking-widest border border-white/5">
                        Motor de Cálculo v2.0
                    </span>
                </div>
            </header>

            <div class="p-8">
                <% if(mensajeError && mensajeError.length > 0) { %>
                    <div class="mb-6 p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <%= mensajeError %>
                    </div>
                <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <!-- Parameters Column -->
                    <div class="lg:col-span-4 space-y-6">
                        <div class="card p-6 bg-dark-800/50 border-white/5 space-y-6 shadow-2xl">
                            <div class="flex items-center gap-3 border-b border-white/5 pb-4">
                                <i class="bi bi-sliders text-accent-primary"></i>
                                <h2 class="text-sm font-bold text-white uppercase tracking-widest">Parámetros del Crédito</h2>
                            </div>

                            <form action="/simulador/calcular" method="POST" class="space-y-5">
                                <div class="space-y-2">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Nombre del Cliente (Opcional)</label>
                                    <div class="relative group">
                                        <input type="text" name="cliente_nombre" class="w-full pl-4 pr-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white font-medium focus:border-accent-primary transition-all group-hover:border-white/20" value="<%= datos.cliente_nombre || '' %>" placeholder="Ej: Juan Pérez">
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Capital a Financiar</label>
                                    <div class="relative group">
                                        <input type="number" step="0.01" name="monto" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white font-bold focus:border-accent-primary transition-all group-hover:border-white/20" value="<%= datos.monto || '' %>" required>
                                        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xs"><%= empresa.moneda %></span>
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Tasa de Interés Nominal (%)</label>
                                    <div class="relative group">
                                        <input type="number" step="0.01" name="interes" class="w-full pl-4 pr-12 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-accent-success font-bold focus:border-accent-primary transition-all group-hover:border-white/20" value="<%= datos.interes || '' %>" required>
                                        <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xs">%</span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div class="space-y-2">
                                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">N° Cuotas</label>
                                        <input type="number" name="cuotas" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary transition-all" value="<%= datos.cuotas || '' %>" required>
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Frecuencia</label>
                                        <select name="frecuencia" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-xs text-white focus:border-accent-primary transition-all cursor-pointer">
                                            <option value="diario" <%= datos.frecuencia == 'diario' ? 'selected' : '' %>>Diario</option>
                                            <option value="semanal" <%= datos.frecuencia == 'semanal' ? 'selected' : '' %>>Semanal</option>
                                            <option value="quincenal" <%= datos.frecuencia == 'quincenal' ? 'selected' : '' %>>Quincenal</option>
                                            <option value="mensual" <%= datos.frecuencia == 'mensual' || !datos.frecuencia ? 'selected' : '' %>>Mensual</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Modelo de Amortización</label>
                                    <select name="sistema_pago" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-xs text-white focus:border-accent-primary transition-all cursor-pointer">
                                        <option value="frances" <%= datos.sistema_pago == 'frances' || !datos.sistema_pago ? 'selected' : '' %>>Sistema Francés (Cuota Fija)</option>
                                        <option value="aleman" <%= datos.sistema_pago == 'aleman' ? 'selected' : '' %>>Sistema Alemán (Cuota Variable)</option>
                                    </select>
                                </div>

                                <div class="pt-4 space-y-3">
                                    <button type="submit" class="w-full py-3 rounded-xl bg-accent-primary text-white font-bold text-xs uppercase tracking-[0.2em] shadow-lg shadow-accent-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2 group">
                                        <i class="bi bi-calculator-fill group-hover:rotate-12 transition-transform"></i>
                                        Proyectar Crédito
                                    </button>
                                    <a href="/simulador" class="w-full py-2 rounded-xl bg-white/5 text-slate-500 font-bold text-[10px] uppercase tracking-widest text-center border border-white/5 hover:bg-white/10 hover:text-white transition-all block">
                                        Limpiar Variables
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Projection Column -->
                    <div class="lg:col-span-8">
                        <% if (resultado) { %>
                            <div class="card bg-dark-800/50 border-white/5 overflow-hidden shadow-2xl flex flex-col h-full max-h-[calc(100vh-12rem)]">
                                <!-- Summary Header -->
                                <div class="p-8 border-b border-white/5 bg-dark-900/50 flex flex-col md:flex-row md:items-center justify-between gap-6">
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 flex-1">
                                        <div class="space-y-1">
                                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Monto del préstamo (Lo que recibes)</span>
                                            <p class="text-xl font-bold text-white tracking-tighter"><%= empresa.moneda %> <%= resultado.montoPrestado.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></p>
                                        </div>
                                        <div class="space-y-1">
                                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest text-accent-success">Intereses a pagar (El costo por el préstamo) (<%= resultado.tasa %>%)</span>
                                            <p class="text-xl font-bold text-accent-success tracking-tighter">+<%= empresa.moneda %> <%= resultado.montoInteres.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></p>
                                        </div>
                                        <div class="space-y-1">
                                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest text-accent-primary">Total a devolver (Préstamo + Intereses)</span>
                                            <p class="text-xl font-bold text-accent-primary tracking-tighter"><%= empresa.moneda %> <%= resultado.montoTotal.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></p>
                                        </div>
                                    </div>
                                    <div class="flex items-center">
                                        <button onclick="window.print()" class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-accent-primary text-white text-xs font-bold uppercase tracking-wider shadow-lg shadow-accent-primary/20 hover:scale-[1.03] active:scale-[0.97] transition-all">
                                            <i class="bi bi-printer-fill text-xs"></i>
                                            <span>Imprimir Plan</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Schedule Table -->
                                <div class="flex-1 overflow-auto">
                                    <table class="table align-middle mb-0">
                                        <thead class="sticky top-0 bg-dark-800 z-10">
                                            <tr>
                                                <th class="ps-8 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">N°</th>
                                                <th class="py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-center">Vencimiento</th>
                                                <th class="py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right">Amortización</th>
                                                <th class="py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right">Interés</th>
                                                <th class="py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right">Cuota Periódica</th>
                                                <th class="pe-8 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right">Saldo Insoluto</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-white/5">
                                            <% resultado.cronograma.forEach(c => { %>
                                                <tr class="hover:bg-white/[0.02] transition-colors group">
                                                    <td class="ps-8 py-4">
                                                        <span class="w-6 h-6 rounded bg-dark-900 flex items-center justify-center text-[10px] font-bold text-slate-400 border border-white/5 group-hover:border-accent-primary/30 group-hover:text-white transition-all">
                                                            <%= c.numero %>
                                                        </span>
                                                    </td>
                                                    <td class="py-4 text-center">
                                                        <span class="text-xs font-bold text-slate-300"><%= c.fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %></span>
                                                    </td>
                                                    <td class="py-4 text-right">
                                                        <span class="text-xs font-bold text-slate-500"><%= (c.amortizacion || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %></span>
                                                    </td>
                                                    <td class="py-4 text-right">
                                                        <span class="text-xs font-bold text-accent-warning/70"><%= (c.interes || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %></span>
                                                    </td>
                                                    <td class="py-4 text-right">
                                                        <span class="text-sm font-black text-white"><%= c.monto.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></span>
                                                    </td>
                                                    <td class="pe-8 py-4 text-right">
                                                        <span class="text-xs font-mono text-slate-600 font-bold"><%= (c.saldo || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %></span>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Disclaimer -->
                                <div class="px-8 py-4 bg-dark-900/50 border-t border-white/5 flex items-center gap-3">
                                    <i class="bi bi-info-circle-fill text-accent-info"></i>
                                    <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest">
                                        Nota: Los valores presentados son proyecciones matemáticas aproximadas. No incluyen comisiones, seguros ni gastos administrativos adicionales.
                                    </p>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="h-full min-h-[400px] border-2 border-dashed border-white/5 rounded-3xl flex flex-col items-center justify-center text-center p-12 space-y-6 group">
                                <div class="w-24 h-24 rounded-full bg-white/5 flex items-center justify-center text-4xl text-slate-700 group-hover:scale-110 group-hover:text-slate-500 transition-all duration-700">
                                    <i class="bi bi-calculator"></i>
                                </div>
                                <div class="space-y-2">
                                    <h3 class="text-lg font-bold text-slate-500">Motor de Simulación Listo</h3>
                                    <p class="text-xs text-slate-600 font-medium max-w-xs leading-relaxed">
                                        Configure los parámetros financieros a la izquierda y presione el botón de cálculo para generar la proyección detallada.
                                    </p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <%- include('../partials/footer') %>
        </main>
    </div>

    <!-- PRINT ONLY CONTAINER (Hidden on Screen via CSS) -->
    <div class="print-only-layout">
        <% if (resultado) { %>
            <!-- Header -->
            <div class="print-header">
                <div class="print-logo-container">
                    <% if (empresa.logo) { %>
                        <img src="/uploads/<%= empresa.logo %>" class="print-logo" alt="Logo">
                    <% } else { %>
                        <div class="print-logo-placeholder">
                            <%= empresa.nombre_empresa ? empresa.nombre_empresa.charAt(0) : 'M' %>
                        </div>
                    <% } %>
                    <div>
                        <h2 style="font-size: 1.25rem; font-weight: 900; margin: 0; color: #0f172a;"><%= empresa.nombre_empresa || 'Mi Financiera' %></h2>
                    </div>
                </div>
                <div class="company-details">
                    <p style="margin: 0;"><%= empresa.direccion || 'Dirección Principal' %></p>
                    <p style="margin: 0;">Teléfono: <%= empresa.telefono || '555-0000' %></p>
                    <p style="margin: 0;">Correo: <%= empresa.email_contacto || 'contacto@empresa.com' %></p>
                </div>
            </div>

            <!-- Title -->
            <div class="print-title">
                <h1>Proyección de Plan de Pagos</h1>
                <p>SISTEMA DE AMORTIZACIÓN <%= resultado.sistema_pago === 'aleman' ? 'ALEMÁN' : 'FRANCÉS' %></p>
            </div>

            <!-- Meta info -->
            <div class="print-meta-grid">
                <div class="print-meta-item">
                    <span>Cliente:</span>
                    <p><%= resultado.cliente_nombre ? resultado.cliente_nombre : 'PÚBLICO EN GENERAL' %></p>
                </div>
                <div class="print-meta-item">
                    <span>Fecha:</span>
                    <p><%= new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) %></p>
                </div>
                <div class="print-meta-item">
                    <span>Frecuencia de Amortización:</span>
                    <p style="text-transform: capitalize;"><%= resultado.frecuencia %></p>
                </div>
            </div>

            <!-- Summary -->
            <div class="print-summary-row">
                <div class="print-summary-card">
                    <span>Monto del préstamo (Lo que recibes)</span>
                    <p><%= empresa.moneda %> <%= resultado.montoPrestado.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></p>
                </div>
                <div class="print-summary-card">
                    <span>Intereses a pagar (El costo por el préstamo) (<%= resultado.tasa %>%)</span>
                    <p><%= empresa.moneda %> <%= resultado.montoInteres.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></p>
                </div>
                <div class="print-summary-card highlight">
                    <span>Total a devolver (Préstamo + Intereses)</span>
                    <p><%= empresa.moneda %> <%= resultado.montoTotal.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></p>
                </div>
            </div>

            <!-- Table -->
            <table class="print-table">
                <thead>
                    <tr>
                        <th style="width: 8%;">N°</th>
                        <th style="text-align: left;">Vencimiento Proyectado</th>
                        <th>Amortización Capital</th>
                        <th>Interés Ordinario</th>
                        <th>Monto Cuota Periodo</th>
                        <th>Saldo Insoluto</th>
                    </tr>
                </thead>
                <tbody>
                    <% resultado.cronograma.forEach(c => { %>
                        <tr>
                            <td style="text-align: left; font-weight: 700;">#<%= c.numero %></td>
                            <td style="text-align: left;"><%= c.fecha.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                            <td><%= (c.amortizacion || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %></td>
                            <td><%= (c.interes || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %></td>
                            <td style="font-weight: 700; color: #000;"><%= c.monto.toLocaleString('es-ES', {minimumFractionDigits: 2}) %></td>
                            <td style="font-family: monospace;"><%= (c.saldo || 0).toLocaleString('es-ES', {minimumFractionDigits: 2}) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- Footer -->
            <div class="print-footer" style="text-align: center; border-top: 1px dashed #cbd5e1; padding-top: 1rem; margin-top: 1rem;">
                <p style="font-size: 0.85rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem;">¡Gracias por confiar en <%= empresa.nombre_empresa || 'Mi Financiera' %>!</p>
                <p style="font-size: 0.7rem; color: #475569; margin: 0;">Trabajamos día a día para brindarte el mejor servicio y apoyarte en el crecimiento de tus proyectos financieros.</p>
            </div>
        <% } %>

<!DOCTYPE html>
<html lang="es">
<%- include('partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <h1 class="text-lg font-bold text-white tracking-tight">Panel de Control</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-info/10 text-accent-info text-[10px] font-bold uppercase tracking-wider border border-accent-info/20">Resumen General</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right hidden sm:block">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest leading-none">Fecha Actual</p>
                    <p class="text-xs font-semibold text-white mt-1"><%= new Date().toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
                <div class="w-px h-8 bg-white/5 mx-2"></div>
                <button class="p-2 rounded-xl bg-white/5 text-slate-400 hover:text-white transition-colors relative">
                    <i class="bi bi-bell text-lg"></i>
                    <% if (typeof alertasVencidos !== 'undefined' && alertasVencidos > 0) { %>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-accent-danger rounded-full ring-2 ring-dark-900"></span>
                    <% } %>
                </button>
            </div>
        </header>

        <div class="p-8 space-y-8">
            <!-- Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Stat Card 1 -->
                <div class="card p-6 flex flex-col justify-between group hover:border-accent-info/30 transition-all">
                    <div class="flex justify-between items-start">
                        <div class="w-12 h-12 rounded-2xl bg-accent-info/10 text-accent-info flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <span class="text-[10px] font-bold text-accent-info uppercase tracking-widest bg-accent-info/5 px-2 py-1 rounded-lg">Clientes</span>
                    </div>
                    <div class="mt-4">
                        <h3 class="text-3xl font-bold text-white tracking-tight"><%= (typeof totales !== 'undefined' && totales.clientes_con_deuda) ? totales.clientes_con_deuda : 0 %></h3>
                        <p class="text-sm text-slate-500 font-medium mt-1">Activos con deuda</p>
                    </div>
                </div>

                <!-- Stat Card 2 -->
                <div class="card p-6 flex flex-col justify-between group hover:border-accent-success/30 transition-all relative overflow-hidden">
                    <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-accent-success/5 rounded-full blur-2xl"></div>
                    <div class="flex justify-between items-start">
                        <div class="w-12 h-12 rounded-2xl bg-accent-success/10 text-accent-success flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            <i class="bi bi-safe2-fill"></i>
                        </div>
                        <button class="p-1.5 rounded-lg bg-accent-success/10 text-accent-success hover:bg-accent-success hover:text-white transition-all text-xs" data-bs-toggle="modal" data-bs-target="#modalInyectar">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="mt-4">
                        <h3 class="text-3xl font-bold text-white tracking-tight">
                            <span class="text-accent-success/50 text-xl font-medium"><%= empresa.moneda || '$' %></span>
                            <%= parseFloat((typeof totales !== 'undefined' && totales.capital_disponible) ? totales.capital_disponible : 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %>
                        </h3>
                        <p class="text-sm text-slate-500 font-medium mt-1">Capital en Bóveda</p>
                    </div>
                </div>

                <!-- Stat Card 3 -->
                <div class="card p-6 flex flex-col justify-between group hover:border-accent-warning/30 transition-all">
                    <div class="flex justify-between items-start">
                        <div class="w-12 h-12 rounded-2xl bg-accent-warning/10 text-accent-warning flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform">
                            <i class="bi bi-cash-coin"></i>
                        </div>
                        <span class="text-[10px] font-bold text-accent-warning uppercase tracking-widest bg-accent-warning/5 px-2 py-1 rounded-lg">Circulante</span>
                    </div>
                    <div class="mt-4">
                        <h3 class="text-3xl font-bold text-white tracking-tight">
                            <span class="text-accent-warning/50 text-xl font-medium"><%= empresa.moneda || '$' %></span>
                            <%= parseFloat((typeof totales !== 'undefined' && totales.capital_prestado) ? totales.capital_prestado : 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %>
                        </h3>
                        <p class="text-sm text-slate-500 font-medium mt-1">Dinero en la calle</p>
                    </div>
                </div>

                <!-- Stat Card 4 -->
                <div class="card p-6 flex flex-col justify-between group hover:border-accent-info/30 transition-all">
                    <div class="flex justify-between items-start">
                        <div class="w-12 h-12 rounded-2xl bg-accent-info/10 text-white flex items-center justify-center text-xl shadow-inner group-hover:scale-110 transition-transform" style="background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded-lg" style="background-color: rgba(59, 130, 246, 0.05); color: #3b82f6;">Rendimiento</span>
                    </div>
                    <div class="mt-4">
                        <h3 class="text-3xl font-bold text-white tracking-tight">
                            <span class="text-accent-info/50 text-xl font-medium" style="color: rgba(59, 130, 246, 0.5);"><%= empresa.moneda || '$' %></span>
                            <%= parseFloat((typeof totales !== 'undefined' && totales.ganancias) ? totales.ganancias : 0).toLocaleString('es-ES', { minimumFractionDigits: 2 }) %>
                        </h3>
                        <p class="text-sm text-slate-500 font-medium mt-1">Intereses Generados</p>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="card overflow-hidden">
                    <div class="p-6 border-b border-white/5 flex items-center justify-between bg-white/[0.02]">
                        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Estado de la Cartera</h4>
                        <i class="bi bi-pie-chart text-slate-500"></i>
                    </div>
                    <div class="p-8">
                        <div class="h-72 w-full">
                            <canvas id="chartEstados"></canvas>
                        </div>
                    </div>
                </div>

                <div class="card overflow-hidden">
                    <div class="p-6 border-b border-white/5 flex items-center justify-between bg-white/[0.02]">
                        <h4 class="text-sm font-bold text-white uppercase tracking-wider">Balance: Prestado vs Recuperado</h4>
                        <i class="bi bi-bar-chart text-slate-500"></i>
                    </div>
                    <div class="p-8">
                        <div class="h-72 w-full">
                            <canvas id="chartBalance"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="space-y-4">
                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-[0.2em]">Accesos Rápidos</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <a href="/prestamos/crear" class="group flex items-center gap-6 p-6 rounded-3xl bg-dark-800 border border-white/5 hover:border-accent-info/40 hover:bg-accent-info/5 transition-all duration-300">
                        <div class="w-16 h-16 rounded-2xl bg-accent-info/10 text-accent-info flex items-center justify-center text-3xl group-hover:scale-110 transition-transform shadow-inner">
                            <i class="bi bi-plus-circle"></i>
                        </div>
                        <div>
                            <span class="block text-lg font-bold text-white">Otorgar Préstamo</span>
                            <span class="text-sm text-slate-500 font-medium">Añadir préstamo y garantía</span>
                        </div>
                        <i class="bi bi-arrow-right ml-auto text-slate-600 group-hover:text-accent-info transition-colors"></i>
                    </a>

                    <a href="/clientes/crear" class="group flex items-center gap-6 p-6 rounded-3xl bg-dark-800 border border-white/5 hover:border-accent-success/40 hover:bg-accent-success/5 transition-all duration-300">
                        <div class="w-16 h-16 rounded-2xl bg-accent-success/10 text-accent-success flex items-center justify-center text-3xl group-hover:scale-110 transition-transform shadow-inner">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div>
                            <span class="block text-lg font-bold text-white">Nuevo Cliente</span>
                            <span class="text-sm text-slate-500 font-medium">Registrar nueva persona</span>
                        </div>
                        <i class="bi bi-arrow-right ml-auto text-slate-600 group-hover:text-accent-success transition-colors"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Modal Inyección de Capital -->
        <div class="modal fade" id="modalInyectar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-white/10 shadow-2xl">
                    <div class="modal-header border-white/5 p-6 bg-accent-success/5">
                        <h5 class="modal-title flex items-center gap-3 text-white font-bold">
                            <div class="w-8 h-8 rounded-lg bg-accent-success/20 text-accent-success flex items-center justify-center">
                                <i class="bi bi-safe2-fill"></i>
                            </div>
                            Inyectar Capital a Bóveda
                        </h5>
                        <button type="button" class="btn-close btn-close-white opacity-50" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/boveda/inyectar" method="POST">
                        <div class="modal-body p-8">
                            <p class="text-slate-400 text-sm mb-6 leading-relaxed">Registra un nuevo aporte financiero a la base monetaria para habilitarlo disponible para préstamos y gastos operativos.</p>
                            <div class="space-y-2">
                                <label class="text-xs font-bold text-slate-500 uppercase tracking-widest ml-1">Monto a Ingresar (<%= empresa.moneda || '$' %>)</label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-500 group-focus-within:text-accent-success transition-colors">
                                        <span class="font-bold"><%= empresa.moneda || '$' %></span>
                                    </div>
                                    <input type="number" step="0.01" name="monto" class="block w-full pl-10 pr-4 py-4 bg-dark-900 border border-white/10 rounded-2xl text-white font-bold text-lg focus:border-accent-success focus:ring-0 transition-all placeholder:text-slate-700" required placeholder="0.00">
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-white/5 p-6 gap-3">
                            <button type="button" class="px-6 py-3 rounded-xl text-sm font-bold text-slate-400 hover:bg-white/5 transition-colors" data-bs-toggle="modal">Cancelar</button>
                            <button type="submit" class="px-6 py-3 rounded-xl text-sm font-bold text-white bg-accent-success shadow-lg shadow-accent-success/20 hover:scale-105 active:scale-95 transition-all flex items-center gap-2">
                                <i class="bi bi-check-circle-fill"></i> Confirmar Inversión
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
    </main>

    <% 
        const safeEstados = (typeof graficos !== 'undefined' && graficos.estados) ? graficos.estados : [0,0,0];
        const safeBalance = (typeof graficos !== 'undefined' && graficos.balance) ? graficos.balance : [0,0];
    %>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Datos seguros
        
        const datosEstados = <%- JSON.stringify(safeEstados) %>; 
        const datosBalance = <%- JSON.stringify(safeBalance) %>; 
        
        const monedaConfig = <%- JSON.stringify((typeof empresa !== 'undefined' && empresa.moneda) ? empresa.moneda : '$') %>;

        // Chart defaults
        Chart.defaults.color = '#94a3b8';
        Chart.defaults.font.family = "'Inter', sans-serif";

        const ctx1 = document.getElementById('chartEstados').getContext('2d');
        new Chart(ctx1, {
            type: 'doughnut',
            data: {
                labels: ['Pendiente', 'Pagado', 'Vencido', 'Finalizado'],
                datasets: [{
                    data: datosEstados,
                    backgroundColor: ['#f59e0b', '#10b981', '#ef4444', '#64748b'],
                    borderColor: '#1e293b',
                    borderWidth: 4,
                    hoverOffset: 20
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: { 
                    legend: { 
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            font: { size: 11, weight: '600' }
                        }
                    } 
                }
            }
        });

        const ctx2 = document.getElementById('chartBalance').getContext('2d');
        const gradient1 = ctx2.createLinearGradient(0, 0, 0, 400);
        gradient1.addColorStop(0, 'rgba(59, 130, 246, 0.5)');
        gradient1.addColorStop(1, 'rgba(59, 130, 246, 0)');

        const gradient2 = ctx2.createLinearGradient(0, 0, 0, 400);
        gradient2.addColorStop(0, 'rgba(16, 185, 129, 0.5)');
        gradient2.addColorStop(1, 'rgba(16, 185, 129, 0)');

        new Chart(ctx2, {
            type: 'bar',
            data: {
                labels: ['Histórico Prestado', 'Total Recuperado'],
                datasets: [{
                    data: datosBalance,
                    backgroundColor: ['#3b82f6', '#10b981'],
                    borderRadius: 12,
                    barThickness: 40,
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                scales: { 
                    y: { 
                        beginAtZero: true,
                        grid: { color: 'rgba(255,255,255,0.05)', drawBorder: false }
                    },
                    x: {
                        grid: { display: false, drawBorder: false }
                    }
                },
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#fff',
                        bodyColor: '#f8fafc',
                        padding: 12,
                        cornerRadius: 12,
                        displayColors: false
                    }
                }
            }
        });
    </script>
</body>
</html>
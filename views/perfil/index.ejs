<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head') %>
<body class="bg-dark-900 text-slate-200">
    <%- include('../partials/sidebar') %>

    <main class="transition-all duration-300">
        <!-- Top Navbar -->
        <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-dark-900/50 backdrop-blur-xl sticky top-0 z-40">
            <div class="flex items-center gap-4">
                <h1 class="text-lg font-bold text-white tracking-tight">Centro de Usuario</h1>
                <span class="px-2 py-0.5 rounded-md bg-accent-primary/10 text-accent-primary text-[10px] font-bold uppercase tracking-wider border border-accent-primary/20">Configuración de Perfil</span>
            </div>
        </header>

        <div class="p-8 max-w-5xl mx-auto space-y-8">
            <% if(mensajeExito && mensajeExito.length > 0) { %>
                <div class="p-4 rounded-xl bg-accent-success/10 border border-accent-success/20 text-accent-success text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-check-circle-fill"></i>
                    <%= mensajeExito %>
                </div>
            <% } %>
            <% if(mensajeError && mensajeError.length > 0) { %>
                <div class="p-4 rounded-xl bg-accent-danger/10 border border-accent-danger/20 text-accent-danger text-sm font-bold flex items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <%= mensajeError %>
                </div>
            <% } %>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Personal Info -->
                <div class="card p-8 bg-dark-800/50 border-white/5 space-y-8">
                    <div class="flex items-center gap-4 border-b border-white/5 pb-6">
                        <div class="w-12 h-12 rounded-2xl bg-accent-primary/10 text-accent-primary flex items-center justify-center text-2xl">
                            <i class="bi bi-person-bounding-box"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-white">Identidad Operativa</h2>
                            <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Datos básicos de su cuenta</p>
                        </div>
                    </div>

                    <form action="/perfil/actualizar" method="POST" class="space-y-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Rango de Acceso</label>
                            <input type="text" class="w-full px-4 py-3 bg-dark-900 border border-white/5 rounded-xl text-xs text-slate-500 font-bold uppercase tracking-widest cursor-not-allowed" value="<%= usuarioData.rol %>" disabled readonly>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Nombre Completo *</label>
                            <input type="text" name="nombre_completo" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all font-bold" value="<%= usuarioData.nombre_completo %>" required>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Correo Electrónico *</label>
                            <input type="email" name="email" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" value="<%= usuarioData.email %>" required>
                        </div>

                        <div class="pt-4">
                            <button type="submit" class="w-full py-4 rounded-xl bg-accent-primary text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-accent-primary/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                <i class="bi bi-save"></i>
                                Actualizar Información
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Security / Password -->
                <div class="card p-8 bg-dark-800/50 border-white/5 space-y-8">
                    <div class="flex items-center gap-4 border-b border-white/5 pb-6">
                        <div class="w-12 h-12 rounded-2xl bg-accent-danger/10 text-accent-danger flex items-center justify-center text-2xl">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-white">Seguridad de Acceso</h2>
                            <p class="text-xs text-slate-500 font-bold uppercase tracking-widest mt-1">Gestión de credenciales privadas</p>
                        </div>
                    </div>

                    <form action="/perfil/password" method="POST" class="space-y-6">
                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Contraseña Vigente *</label>
                            <input type="password" name="password_actual" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-danger focus:ring-0 transition-all" placeholder="Requerido para autorizar" required>
                        </div>

                        <div class="h-px bg-white/5 my-2"></div>

                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Nueva Contraseña *</label>
                            <input type="password" name="password_nueva" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" placeholder="••••••••" required>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] ml-1">Validar Nueva Contraseña *</label>
                            <input type="password" name="password_confirmar" class="w-full px-4 py-3 bg-dark-900 border border-white/10 rounded-xl text-sm text-white focus:border-accent-primary focus:ring-0 transition-all" placeholder="••••••••" required>
                        </div>

                        <div class="pt-4">
                            <button type="submit" class="w-full py-4 rounded-xl bg-accent-danger text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-accent-danger/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                                <i class="bi bi-key-fill"></i>
                                Reestablecer Acceso
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <%- include('../partials/footer') %>
    </main>
</body>
</html>